<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF14161A"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="自动配置无线调试" />

    <TextView
        android:id="@+id/acStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFB9BEC7"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:text="检查中…" />

    <Button
        android:id="@+id/acGrant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#FF2F6FED"
        android:textColor="#FFFFFFFF"
        android:textAllCaps="false"
        android:text="1. 去开启无障碍权限" />

    <Button
        android:id="@+id/acRun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FF2F6FED"
        android:textColor="#FFFFFFFF"
        android:textAllCaps="false"
        android:text="2. 自动打开无线调试并读取端口" />

    <Button
        android:id="@+id/acDump"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FF2A2E36"
        android:textColor="#FFB9BEC7"
        android:textAllCaps="false"
        android:text="（调试）读取当前屏幕内容" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#FF8A9099"
        android:textSize="12sp"
        android:text="结果：" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="#FF0E1013"
        android:padding="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <TextView
                android:id="@+id/acOutput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFD7DBE0"
                android:textSize="12sp"
                android:typeface="monospace"
                android:lineSpacingExtra="4dp" />
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
