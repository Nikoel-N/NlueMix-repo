<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ══════════ 深色主题调色板 ══════════

      这个文件【只放颜色/画刷/阴影】，不放任何控件样式。
      控件样式（按钮、输入框、滑块…）在 Theme.xaml 里，通过 DynamicResource 引用这里的 key。

      为什么要这样拆：
        深色/浅色切换要求运行时就地换掉颜色。StaticResource 只在加载时解析一次，
        换字典不会生效，所以样式里对颜色的引用必须写成 DynamicResource。
        把颜色单独放一个字典，切换时只要替换 MergedDictionaries 里的这一项即可。
    -->

    <!-- 背景：极淡的渐变，纯色会显得死板 -->
    <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#FF0C1017" Offset="0" />
        <GradientStop Color="#FF080A10" Offset="1" />
    </LinearGradientBrush>

    <!-- 四级明度递进：深色界面靠明度表达层级，不靠描边 -->
    <SolidColorBrush x:Key="Surface1" Color="#FF11151F" />
    <SolidColorBrush x:Key="Surface2" Color="#FF171C28" />
    <SolidColorBrush x:Key="Surface3" Color="#FF1F2634" />
    <SolidColorBrush x:Key="Card" Color="#FF11151F" />
    <SolidColorBrush x:Key="CardHover" Color="#FF171C28" />

    <SolidColorBrush x:Key="Accent" Color="#FF4C8DFF" />
    <SolidColorBrush x:Key="AccentDeep" Color="#FF2F6BE0" />
    <SolidColorBrush x:Key="AccentSoft" Color="#334C8DFF" />
    <SolidColorBrush x:Key="Good" Color="#FF3DDC97" />
    <SolidColorBrush x:Key="Warn" Color="#FFFFB020" />
    <SolidColorBrush x:Key="Bad" Color="#FFFF5C5C" />

    <SolidColorBrush x:Key="Text" Color="#FFEEF2F9" />
    <SolidColorBrush x:Key="TextDim" Color="#FF9AA6BC" />
    <SolidColorBrush x:Key="TextFaint" Color="#FF66718A" />

    <!-- hairline：深色界面的分隔线必须极淡 -->
    <SolidColorBrush x:Key="Line" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="LineStrong" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Field" Color="#FF1A202C" />
    <SolidColorBrush x:Key="FieldHover" Color="#FF1F2634" />
    <SolidColorBrush x:Key="PopupBg" Color="#FF151A24" />

    <!-- 工具条/次要按钮的"极淡底色"，深浅主题里方向相反 -->
    <SolidColorBrush x:Key="TintSubtle" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TintHover" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="TintPress" Color="#22FFFFFF" />

    <DropShadowEffect x:Key="ShadowCard" BlurRadius="22" ShadowDepth="4" Direction="270"
                      Color="#000000" Opacity="0.45" />
    <DropShadowEffect x:Key="ShadowPopup" BlurRadius="30" ShadowDepth="8" Direction="270"
                      Color="#000000" Opacity="0.6" />
</ResourceDictionary>
