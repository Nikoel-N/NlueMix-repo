<Window x:Class="NlueMix.UI.RiskNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NlueMix 使用前必读"
        Width="980" Height="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource Surface1}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" x:Name="TxtTitle"
                   FontSize="26" FontWeight="Bold" Foreground="#FFFFFFFF"
                   Text="NlueMix 使用前必读"/>

        <!-- 副标题：和正文同字号，不做小字 -->
        <TextBlock Grid.Row="1" x:Name="TxtSubtitle"
                   Margin="0,10,0,16" TextWrapping="Wrap"
                   FontSize="14" LineHeight="23" Foreground="{DynamicResource TextDim}"/>

        <!-- 正文：等宽，可滚动，字号与全局一致 -->
        <Border Grid.Row="2" Background="{DynamicResource Surface1}" CornerRadius="8" Padding="20,16">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtBody"
                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                           FontSize="13.5" LineHeight="21"
                           Foreground="{DynamicResource Text}" TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>

        <!-- 确认勾选 -->
        <CheckBox Grid.Row="3" x:Name="ChkRead" Margin="2,18,0,0"
                  FontSize="14" Foreground="{DynamicResource Text}"
                  Content="我确认已完整阅读以上全部内容"/>

        <!-- 按钮 -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="TxtHint" VerticalAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource TextFaint}"
                       Text="点右上角关闭或按 Esc 即退出，软件不会做任何事。"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClosePermanently" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,12,0" Click="OnClosePermanently"
                        Content="同意，并永久关闭此提示"/>
                <Button x:Name="BtnAgree" Style="{StaticResource PrimaryButton}"
                        Click="OnAgree" Content="我已阅读并同意，继续使用"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
