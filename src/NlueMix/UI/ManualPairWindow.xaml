<Window x:Class="NlueMix.UI.ManualPairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动连接手机（无线调试）"
        Width="660" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Surface1}"
        Foreground="{DynamicResource Text}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource Surface3}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface1}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="手动连接手机" FontSize="22" FontWeight="Bold" Foreground="White"/>

        <!-- 说明：告诉用户这些数字在手机的哪儿 -->
        <Border Grid.Row="1" Background="{DynamicResource Surface1}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="{DynamicResource TextDim}">
                <Run Text="手机上打开：&#x0a;设置 → 更多设置 → 开发者选项 → 无线调试&#x0a;&#x0a;"/><LineBreak/>
                <Run Text="① 页面上会显示「IP 地址和端口」，形如 192.168.1.6:37251" FontWeight="SemiBold"/><LineBreak/>
                <Run Text="   → 填到下面的「手机 IP」和「连接端口」"/><LineBreak/>
                <Run Text="② 如果是第一次连这台电脑，再点「使用配对码配对设备」" FontWeight="SemiBold"/><LineBreak/>
                <Run Text="   → 弹窗里会显示「Wi-Fi 配对码」（6 位数字）和一组 IP:端口"/><LineBreak/>
                <Run Text="   → 把配对码填到下面，「配对端口」填弹窗里那个端口"/><LineBreak/>
                <Run Text="&#x0a;配对只需要做一次。以后只要填①的两个值即可。"/><LineBreak/>
                <Run Text="无线调试的端口每次重启都会变，所以这一步可能要重做。"/><LineBreak/>
            </TextBlock>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="手机 IP" Foreground="{DynamicResource TextFaint}" FontSize="13"/>
                <TextBox x:Name="TxtIp" Margin="0,6,0,0" Text="192.168.1."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="连接端口" Foreground="{DynamicResource TextFaint}" FontSize="13"/>
                <TextBox x:Name="TxtConnectPort" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="配对端口（已配对过就留空）" Foreground="{DynamicResource TextFaint}" FontSize="13"/>
                <TextBox x:Name="TxtPairPort" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Wi-Fi 配对码（6 位）" Foreground="{DynamicResource TextFaint}" FontSize="13"/>
                <TextBox x:Name="TxtPairCode" Margin="0,6,0,0" MaxLength="6" FontSize="20"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="BtnPairConnect" Style="{StaticResource PrimaryButton}"
                    Content="配对并连接" Click="OnPairConnect"/>
            <Button x:Name="BtnConnectOnly" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Content="仅连接（已配对过）" Click="OnConnectOnly"/>
        </StackPanel>

        <Border Grid.Row="5" Background="{DynamicResource Surface1}" CornerRadius="8" Padding="14,12" Margin="0,16,0,0" MinHeight="130">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtResult" TextWrapping="Wrap"
                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                           FontSize="13" LineHeight="21" Foreground="{DynamicResource Text}"
                           Text="（还没执行）"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnClose" Style="{StaticResource SecondaryButton}" Content="关闭" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
